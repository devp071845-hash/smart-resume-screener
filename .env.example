# Copy this file to .env and fill in your key, or export it directly:
#   export GOOGLE_API_KEY=AIza...
#
# Get a key at https://aistudio.google.com/apikey
#
# Without this key set, the app still runs, but falls back to a labeled
# heuristic (keyword-overlap) extractor/scorer instead of the LLM.
GOOGLE_API_KEY=

# Optional: override the Gemini model (Google periodically retires model
# IDs — see https://ai.google.dev/gemini-api/docs/changelog). Defaults to
# gemini-2.5-flash if unset.
GEMINI_MODEL=
